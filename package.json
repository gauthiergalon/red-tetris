{
	"name": "red-tetris",
	"version": "0.0.1",
	"description": "A simple Tetris game",
	"type": "module",
	"scripts": {
		"dev:server": "tsx --watch server/src/index.ts",
		"dev:client": "vite",
		"build": "vite build",
		"start": "node server/src/index.ts",
		"typecheck": "tsc -p server && tsc -p client",
		"format": "biome format --write .",
		"lint": "biome lint --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tsx": "^4.19.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"express": "^5.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"react-router-dom": "^7.18.5"
	}
}
